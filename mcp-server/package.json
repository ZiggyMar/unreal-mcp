{
  "name": "unreal-mcp-server",
  "version": "0.1.0",
  "description": "An MCP server that allows AI agents (Claude, Cursor) to directly control and manipulate Unreal Engine.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "unreal-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run check:parity && npm run check:journal && npm run check:symptoms && npm run check:guides && npm run check:docs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "_comment_emit": "npm test measures dist/, so it must BUILD it first. It used to run typecheck, which emits nothing - so every profile measurement was taken against whatever dist happened to hold, and a description that pushed a profile over its ceiling passed until someone rebuilt by hand.",
    "emit": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "check:parity": "node scripts/check-tool-parity.mjs",
    "check:journal": "node scripts/check-journal.mjs",
    "check:symptoms": "node scripts/check-symptoms.mjs",
    "check:guides": "node scripts/check-guides.mjs",
    "test": "npm run emit && npm run check:parity && npm run check:docs && npm run check:claims && npm run check:nodetypes && npm run check:types && npm run check:undo && npm run check:params && npm run check:envelopes && npm run check:entrytypes && npm run check:profiles && npm run check:replies && npm run check:protocol && npm run test:unit",
    "test:unit": "node --test",
    "verify:live": "node scripts/live-verify.mjs",
    "fuzz:crash": "node scripts/fuzz-nodes.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:handbook": "node scripts/verify-handbook.mjs",
    "measure:cost": "node scripts/measure-cost.mjs",
    "verify:restart": "node scripts/verify-restart.mjs",
    "bench:local": "node scripts/bench-local-model.mjs",
    "check:envelopes": "node scripts/check-envelopes.mjs",
    "check:entrytypes": "node scripts/check-entry-types.mjs",
    "check:profiles": "node scripts/measure-profiles.mjs",
    "stress": "node scripts/stress-build.mjs",
    "build:engines": "node scripts/build-engines.mjs",
    "check:fresh": "node scripts/check-binary-fresh.mjs",
    "check:protocol": "node scripts/check-protocol.mjs",
    "audit": "node scripts/audit-project.mjs",
    "check:replies": "node scripts/check-response-budgets.mjs",
    "measure:reads": "node scripts/measure-reads.mjs",
    "trial:feature": "node scripts/trial-feature.mjs",
    "check:engines": "node scripts/build-engines.mjs --isolated",
    "measure:groups": "node scripts/measure-groups.mjs",
    "trial:diagnose": "node scripts/trial-diagnose.mjs",
    "trial:runtime": "node scripts/trial-runtime.mjs",
    "measure:rubberband": "node scripts/measure-rubberband.mjs",
    "trial:findtruth": "node scripts/trial-find-truth.mjs",
    "trial:dispatch": "node scripts/trial-dispatch.mjs",
    "trial:nodesearch": "node scripts/trial-node-search.mjs",
    "trial:parent-call": "node scripts/trial-parent-call.mjs",
    "trial:chain": "node scripts/trial-chain.mjs",
    "trial:workflows": "node scripts/trial-workflows.mjs",
    "trial:lifecycle": "node scripts/trial-lifecycle.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:nodetypes": "node scripts/check-node-types.mjs",
    "check:types": "node scripts/check-type-grammar.mjs",
    "check:undo": "node scripts/check-undo.mjs",
    "check:params": "node scripts/check-param-names.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
